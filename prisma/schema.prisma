generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vaga {
  id          String   @id @default(uuid())
  titulo      String
  empresa     String
  local       String
  data        String?
  link        String   @unique
  termo       String
  fonte       String
  descricao   String?
  isTI        Boolean  @default(true)
  competencias String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Usuario {
  id           String        @id @default(uuid())
  nome         String
  email        String        @unique
  senha        String
  createdAt    DateTime      @default(now())
  preferencias String[]      @default([])
  candidaturas Candidatura[]
  vagasSalvas  VagaSalva[]
}

model Candidatura {
  id           String   @id @default(uuid())
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  vagaLink     String
  titulo       String?
  empresa      String?
  local        String?
  fonte        String?
  status       String   @default("salvo") // salvo, candidatado, entrevista, rejeitado, arquivado
  etiquetas    String[] @default([])
  notas        String?
  contatoRH    String?
  salario      String?
  prazo        String?
  lembrete     String?
  adicionadoEm DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([usuarioId, vagaLink])
}

model VagaSalva {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  vagaLink  String
  oculta    Boolean  @default(false)
  favorita  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([usuarioId, vagaLink])
}
